{
  "name": "codex-continue-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:desktop",
    "dev:web": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "dev.withoutmelv.codexcontinue",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
